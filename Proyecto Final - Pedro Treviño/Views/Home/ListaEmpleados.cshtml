@model IEnumerable<Proyecto_Final___Pedro_Treviño.Models.Empleados>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ListaEmpleados</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/estilosEmpleados.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <div class="container mt-5">
        <div class="card shadow-lg rounded-4 border-0">
            <div class="card-header bg-primary text-white text-center rounded-top-4">
                <h1 class="mb-0"><i class="fas fa-users me-2"></i> Lista De Empleados</h1>
            </div>

            <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4 rounded-bottom">
                <div class="container-fluid">

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavEmpleados"
                            aria-controls="navbarNavEmpleados" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNavEmpleados">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" href="~/Home/Acceso">
                                    <i class="fas fa-home me-1"></i> Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="~/Home/ListaEmpleados">
                                    <i class="fas fa-users me-1"></i> Empleados
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/Home/CalcularNomina">
                                    <i class="fas fa-calculator me-1"></i> Nómina
                                </a>
                            </li>
                        </ul>
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-semibold" href="~/Home/CerrarSesion">
                                    <i class="fas fa-sign-out-alt me-1"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="card-body">
                <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <button class="btn btn-primary rounded-pill shadow-sm me-2" onclick="ModalRegistrar()">
                            <i class="fas fa-user-plus me-1"></i> Crear Nuevo Empleado
                        </button>
                        <button class="btn btn-info rounded-pill shadow-sm" onclick="descargarExcel()">
                            <i class="fas fa-file-excel me-1"></i> Exportar Excel
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <label for="filtroCategoria" class="mb-0 fw-semibold d-flex align-items-center">
                            <i class="fas fa-filter me-1 text-secondary"></i> Filtrar por categoría:
                        </label>
                        <select id="filtroCategoria" class="form-select shadow-sm rounded-pill" style="width: 220px; min-width: 180px;">
                            <option value="">Todas</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive rounded-4 shadow-sm">
                    <table id="example" class="table table-bordered table-hover align-middle text-center" style="table-layout: auto;">
                        <thead class="table-primary">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.id_empleado)</th>
                                <th>@Html.DisplayNameFor(model => model.apellido)</th>
                                <th>@Html.DisplayNameFor(model => model.nombre)</th>
                                <th style="width: 300px;">@Html.DisplayNameFor(model => model.correo)</th>
                                <th>@Html.DisplayNameFor(model => model.usuario)</th>
                                <th>@Html.DisplayNameFor(model => model.contrasena)</th>
                                <th>@Html.DisplayNameFor(model => model.rol)</th>
                                <th>@Html.DisplayNameFor(model => model.categoria)</th>
                                <th>@Html.DisplayNameFor(model => model.sueldo)</th>
                                <th class="text-center bg-info text-white">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.id_empleado)</td>
                                    <td>@Html.DisplayFor(modelItem => item.apellido)</td>
                                    <td>@Html.DisplayFor(modelItem => item.nombre)</td>
                                    <td style="word-break: break-word; white-space: normal;">@Html.DisplayFor(modelItem => item.correo)</td>
                                    <td>@Html.DisplayFor(modelItem => item.usuario)</td>
                                    <td>••••••</td>
                                    <td>
                                        @(item.rol == 1 ? "Administrador" :
                                          item.rol == 2 ? "Empleado" : "Otra")
                                    </td>
                                    <td>
                                        @(item.categoria == 1 ? "Tiempo Completo" :
                                          item.categoria == 2 ? "Tiempo Parcial" :
                                          item.categoria == 3 ? "Contratista" : "Otra")
                                    </td>
                                    <td>$ @Html.DisplayFor(modelItem => item.sueldo)</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="@Url.Action("Edit", new { id = item.id_empleado })" class="btn btn-warning btn-sm" title="Editar">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                            <a href="@Url.Action("Details", new { id = item.id_empleado })" class="btn btn-primary btn-sm" title="Información">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = item.id_empleado })" class="btn btn-danger btn-sm" title="Eliminar">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Registrar -->
    <div class="modal fade" id="RegistrarseModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 shadow-lg">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title" id="exampleModalLabel"><i class="fas fa-user-plus"></i> Registrar Empleado</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-success d-none" id="msgCorrecto">Registro Correcto</div>
                    <div class="alert alert-danger d-none" id="DivMsgError"><span id="msgError"></span></div>

                    <form id="registrarForm">
                        <label class="form-label fw-semibold">Nombre</label>
                        <input type="text" id="txtNombre" name="txtNombre" class="form-control" />
                        <br />
                        <label class="form-label fw-semibold">Apellido</label>
                        <input type="text" id="txtApellido" name="txtApellido" class="form-control" />
                        <br />
                        <label class="form-label fw-semibold">Rol</label>
                        <select id="selRol" name="selRol" class="form-select"></select>
                        <br />
                        <label class="form-label fw-semibold">Categoría</label>
                        <select id="selCategoria" name="selCategoria" class="form-select"></select>
                        <br />
                        <label for="txtSueldo" class="form-label fw-semibold">Sueldo</label>
                        <input type="number" id="txtSueldo" class="form-control" placeholder="Selecciona una categoría" />
                        <br />
                        <label class="form-label fw-semibold">Correo</label>
                        <input type="email" id="txtCorreo" name="txtCorreo" class="form-control" />
                        <br />
                        <label class="form-label fw-semibold">Usuario</label>
                        <input type="text" id="txtUsuario" name="txtUsuario" class="form-control" />
                        <br />
                        <label class="form-label fw-semibold">Contraseña</label>
                        <input type="password" id="txtContrasena" name="txtContrasena" class="form-control" />
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill shadow-sm" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-primary rounded-pill shadow-sm" onclick="registrarEmpleado()">
                        <i class="fas fa-user-plus me-1"></i> Crear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.0.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

    <script src="~/datatables/dataTables.min.js"></script>
    <script src="~/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/registraEmpleado.js"></script>


</body>
</html>
