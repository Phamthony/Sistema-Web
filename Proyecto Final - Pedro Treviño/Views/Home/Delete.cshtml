@model Proyecto_Final___Pedro_Treviño.Models.Empleados

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <div class="container mt-5">
        <div class="card shadow-lg rounded-4 border-0 mx-auto" style="max-width: 800px;">
            <div class="card-header bg-danger text-white text-center rounded-top-4">
                <h3 class="mb-0"><i class="fas fa-trash-alt me-2"></i> ¿Deseas eliminar esta información?</h3>
            </div>

            <div class="card-body px-5">
                <table class="table table-borderless align-middle">
                    <tbody>
                        <tr>
                            <th class="text-end text-secondary w-50"><i class="fas fa-id-badge me-2"></i> @Html.DisplayNameFor(model => model.id_empleado)</th>
                            <td>@Html.DisplayFor(model => model.id_empleado)</td>
                        </tr>
                        <tr>
                            <th class="text-end text-secondary"><i class="fas fa-user me-2"></i> @Html.DisplayNameFor(model => model.apellido)</th>
                            <td>@Html.DisplayFor(model => model.apellido)</td>
                        </tr>
                        <tr>
                            <th class="text-end text-secondary"><i class="fas fa-user-tag me-2"></i> @Html.DisplayNameFor(model => model.nombre)</th>
                            <td>@Html.DisplayFor(model => model.nombre)</td>
                        </tr>
                        <tr>
                            <th class="text-end text-secondary"><i class="fas fa-envelope me-2"></i> @Html.DisplayNameFor(model => model.correo)</th>
                            <td>@Html.DisplayFor(model => model.correo)</td>
                        </tr>
                        <tr>
                            <th class="text-end text-secondary"><i class="fas fa-user-circle me-2"></i> @Html.DisplayNameFor(model => model.usuario)</th>
                            <td>@Html.DisplayFor(model => model.usuario)</td>
                        </tr>
                        <tr>
                            <th class="text-end text-secondary"><i class="fas fa-lock me-2"></i> @Html.DisplayNameFor(model => model.contrasena)</th>
                            <td>@Html.DisplayFor(model => model.contrasena)</td>
                        </tr>
                        <tr>
                            <th class="text-end text-secondary"><i class="fas fa-user-shield me-2"></i> @Html.DisplayNameFor(model => model.rol)</th>
                            <td>@Html.DisplayFor(model => model.rol)</td>
                        </tr>
                        <tr>
                            <th class="text-end text-secondary"><i class="fas fa-clock me-2"></i> @Html.DisplayNameFor(model => model.categoria)</th>
                            <td>@Html.DisplayFor(model => model.categoria)</td>
                        </tr>
                        <tr>
                            <th class="text-end text-secondary"><i class="fas fa-dollar-sign me-2"></i> @Html.DisplayNameFor(model => model.sueldo)</th>
                            <td>@Html.DisplayFor(model => model.sueldo)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-light text-center py-4 rounded-bottom-4">
                @using (Html.BeginForm("Eliminar", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.id_empleado)

                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <button type="submit" class="btn btn-danger rounded-pill shadow-sm px-4"
                                onclick="return confirm('¿Estás seguro de que deseas eliminar este empleado?');">
                            <i class="fas fa-trash me-2"></i> Eliminar
                        </button>

                        @Html.ActionLink("Cancelar", "ListaEmpleados", null, new
                        {
                            @class = "btn btn-outline-secondary rounded-pill shadow-sm px-4"
                        })
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>
