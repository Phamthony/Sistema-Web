@model Proyecto_Final___Pedro_Treviño.Models.Login

@{
    Layout = null;

    string rol = Session["rol"]?.ToString();
}


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Acceso</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/estilos.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>

    @if (rol == "1")
    {
        <div class="container mt-5">
            <div class="card shadow-lg rounded-4 border-0">
                <div class="card-header bg-dark text-white text-center rounded-top-4">
                    <h1 class="mb-0">BIENVENIDO</h1>
                </div>

                <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4">
                    <div class="container-fluid">

                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                <li class="nav-item">
                                    <a class="nav-link" href="~/Home/Acceso">
                                        <i class="fas fa-home"></i> Inicio
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link active" aria-current="page" href="~/Home/ListaEmpleados">
                                        <i class="fas fa-users me-1"></i> Empleados
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="~/Home/CalcularNomina">
                                        <i class="fas fa-calculator"></i> Nómina
                                    </a>
                                </li>
                            </ul>

                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-semibold" href="~/Home/CerrarSesion">
                                        <i class="fas fa-sign-out-alt"></i> Cerrar sesión
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <div class="row row-cols-1 g-4 mt-3">
                    <!-- Gestión de Empleados -->
                    <div class="col">
                        <div class="text-center">
                            <div class="card-body">
                                <i class="fas fa-users fa-3x text-primary mb-3"></i>
                                <h5 class="card-title">Gestión de Empleados</h5>
                                <p class="card-text">Consulta, agrega o edita la información del personal registrado en el sistema.</p>
                            </div>
                        </div>
                    </div>

                    <br />
                    <!-- Cálculo de Nómina -->
                    <div class="col">
                        <div class="text-center">
                            <div class="card-body">
                                <i class="fas fa-file-invoice-dollar fa-3x text-success mb-3"></i>
                                <h5 class="card-title">Cálculo de Nómina</h5>
                                <p class="card-text">Calcula el sueldo neto diario por las horas trabajadas</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    else if (rol == "2")
    {
        <div class="container mt-5">
            <div class="card shadow-lg rounded-4 border-0">
                <div class="card-header bg-dark text-white text-center rounded-top-4">
                    <h1 class="mb-0">BIENVENIDO</h1>
                </div>

                <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4">
                    <div class="container-fluid">

                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                <li class="nav-item">
                                    <a class="nav-link" href="~/Home/Acceso">
                                        <i class="fas fa-home"></i> Inicio
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="~/Home/CalcularNomina">
                                        <i class="fas fa-calculator"></i> Nómina
                                    </a>
                                </li>
                            </ul>

                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-semibold" href="~/Home/CerrarSesion">
                                        <i class="fas fa-sign-out-alt"></i> Cerrar sesión
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
                <!-- Cálculo de Nómina -->
                <div class="col">
                    <div class="text-center">
                        <div class="card-body">
                            <i class="fas fa-file-invoice-dollar fa-3x text-success mb-3"></i>
                            <h5 class="card-title">Cálculo de Nómina</h5>
                            <p class="card-text">Calcula el sueldo neto diario por sus horas trabajadas</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</body>
</html>
